# Copy to backend/.env and fill in. Never commit the real .env file.

# ---------- Required ----------
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/talkify
JWT_SECRET=use-a-long-random-string
PORT=5000
NODE_ENV=development

# ---------- Frontend access (CORS) ----------
# Only these origins may call the API / open sockets. Comma separated, no trailing slash.
# The backend's own origin is always allowed; localhost is allowed only when NODE_ENV != production.
FRONTEND_URL=https://your-frontend.vercel.app

# ---------- OTP email (pick ONE provider) ----------
# MAIL_FROM must be a sender address verified with your provider.
MAIL_FROM=you@example.com
MAIL_FROM_NAME=Talkify

# Option 1 (recommended on Render): Brevo HTTPS API — Brevo dashboard > SMTP & API > API Keys
BREVO_API_KEY=

# Option 2: Resend HTTPS API — MAIL_FROM must be on a domain verified in Resend
RESEND_API_KEY=

# Option 3: SMTP (often blocked on free cloud hosts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: force a provider (brevo | resend | smtp)
MAIL_PROVIDER=

# ---------- Video calls ----------
# TURN relay for users behind strict NAT / mobile networks (e.g. Metered, Twilio, coturn).
TURN_URLS=turn:your.turn.server:3478,turns:your.turn.server:5349
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional: STUN_URLS=stun:stun.l.google.com:19302

# ---------- Media / AI ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
